GC_REGION=us-central1
GC_CLOUD_RUN_SERVICE_NAME=ac-agent-gateway-extension-service

IDP_TOKEN_ENDPOINT=https://auth.pingone.<region>/<environment-id>/as/token
IDP_CLIENT_ID=replace-me
IDP_CLIENT_SECRET=replace-me

# Shared intermediate PingOne audience that Support Agent's and Order Status
# Agent's own RFC 8693 exchanges target — never validated by anyone downstream.
# The gateway is the only party that ever exchanges *from* this audience to a
# hop's real, final audience (A2A_REQUIRED_AUDIENCE / MCP_REQUIRED_AUDIENCE
# below), which keeps each final PingOne resource purely terminal (sub + act
# only, no may_act needed) instead of being touched by two exchanges.
AGENT_GATEWAY_AUDIENCE=ac-google-cloud-agent-gateway

# Native Order Status Agent A2A endpoint. Populate after deploying the Order Status Agent.
A2A_TARGET_URL=https://us-central1-aiplatform.googleapis.com/v1beta1/projects/<project-number>/locations/us-central1/reasoningEngines/<engine-id>/a2a
# The real, final audience/scope the gateway exchanges *to* for this hop — not
# what's validated on the incoming request (that's always AGENT_GATEWAY_AUDIENCE).
A2A_REQUIRED_AUDIENCE=order-status-agent
A2A_REQUIRED_SCOPE=order-status:invoke

MCP_TARGET_URL=https://ac-order-status-mcp-server-f447x3emfq-uc.a.run.app/mcp
MCP_REQUIRED_AUDIENCE=order-status-mcp-server
MCP_REQUIRED_SCOPE=order:read

# PingOne Authorize is mandatory — there is no bypass mode. Every tools/call
# and A2A message:send is evaluated against this decision endpoint; any config
# gap or decision error fails closed (DENY), never open. The client is the
# PingOne Worker application allowed to call the decision endpoint.
AUTHZ_DECISION_ENDPOINT=https://api.pingone.<region>/v1/environments/<environment-id>/decisionEndpoints/<endpoint-id>
AUTHZ_CLIENT_ID=replace-me
AUTHZ_CLIENT_SECRET=replace-me
