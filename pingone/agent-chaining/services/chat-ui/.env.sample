GC_REGION=us-central1
GC_CLOUD_RUN_SERVICE_NAME=ac-chat-ui
VITE_IDP_ISSUER=https://auth.pingone.<your-region>/<your-env>/as
# AC Chat UI application in PingOne
VITE_CLIENT_ID=
VITE_REDIRECT_URI=https://ac-chat-ui-<your-project-number>.<your-deployment-region>.run.app
# URL and scope for the agent bridge (outbound token)
VITE_AGENT_BRIDGE_URL=https://ac-agent-bridge-<your-project-number>.<your-deployment-region>.run.app
VITE_SCOPES=openid profile email support-agent:invoke
