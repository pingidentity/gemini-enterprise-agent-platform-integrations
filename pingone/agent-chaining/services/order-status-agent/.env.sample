# Google Cloud
GC_PROJECT_ID=your-project-id
GC_REGION=us-central1
AGENT_DISPLAY_NAME=order-status-agent
GC_AGENT_GATEWAY=projects/your-project-id/locations/us-central1/agentGateways/agent-chain-gateway

# Native A2A input and MCP target
A2A_ORDER_STATUS_AUDIENCE=order-status-agent
A2A_ORDER_STATUS_SCOPE=order-status:invoke
MCP_ORDER_STATUS_SERVER_URL=https://order-status-mcp-server.example.com/mcp
MCP_ORDER_STATUS_SCOPE=order:read
ORDER_STATUS_AGENT_ID=order-status-agent

# Own RFC 8693 exchange (to the MCP server) targets this shared intermediate
# audience, not order-status-mcp-server directly — the gateway extension
# performs the real exchange to order-status-mcp-server on top of this one.
# Must match AGENT_GATEWAY_AUDIENCE in the gateway extension's own config.
AGENT_GATEWAY_AUDIENCE=ac-google-cloud-agent-gateway

# PingOne RFC 8693 exchange
LOCAL_DELEGATION_MODE=false
AGENT_IDP_TOKEN_ENDPOINT=https://auth.pingone.<region>/<environment-id>/as/token
AGENT_IDP_CLIENT_ID=replace-me
AGENT_IDP_CLIENT_SECRET=replace-me
