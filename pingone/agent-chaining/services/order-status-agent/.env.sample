GC_REGION=us-central1
AGENT_DISPLAY_NAME=ac-order-status-agent
IDP_ISSUER=https://auth.pingone.<your-region>/<your-env>/as
# Bare gateway name — the full resource path is derived from gcloud at deploy time
GC_AGENT_GATEWAY=ac-agent-gateway
# Required Audience and Scope for this resource
IDP_REQUIRED_AUDIENCE=order-status-agent
IDP_REQUIRED_SCOPE=order-status:invoke
# Outbound MCP target
TOOL_URL=https://ac-order-status-mcp-server-<your-project-number>.<your-deployment-region>.run.app/mcp
TOOL_SCOPE=order:read
# Shared intermediate exchange audience
GATEWAY_AUDIENCE=ac-google-cloud-agent-gateway
# AC Order Status Agent in PingOne
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=
