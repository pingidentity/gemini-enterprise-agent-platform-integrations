GC_REGION=us-central1
AGENT_DISPLAY_NAME=ac_support_agent
IDP_ISSUER=https://auth.pingone.<your-region>/<your-env>/as
# Bare gateway name — the full resource path is derived from gcloud at deploy time
GC_AGENT_GATEWAY=ac-agent-gateway
# AC Support Agent in PingOne
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=
# Required Audience and Scope for this resource
IDP_REQUIRED_AUDIENCE=support-agent
IDP_REQUIRED_SCOPE=support-agent:invoke
# A2A target and scope for the downstream order status agent (outbound token)
AGENT_ENGINE_ID=<PLACEHOLDER>
AGENT_SCOPE=order-status:invoke
# Audience that the gateway service extension expects (outbound token)
GATEWAY_AUDIENCE=ac-google-cloud-agent-gateway
