# Google Cloud
GC_PROJECT_ID=your-project-id
GC_REGION=us-central1
AGENT_DISPLAY_NAME=support-agent
GC_AGENT_GATEWAY=projects/your-project-id/locations/us-central1/agentGateways/agent-chain-gateway

# Native Order Status Agent A2A endpoint. Populate after deploying the Order Status Agent.
A2A_ORDER_STATUS_AGENT_URL=https://us-central1-aiplatform.googleapis.com/v1beta1/projects/<project-number>/locations/us-central1/reasoningEngines/<engine-id>/a2a
A2A_ORDER_STATUS_SCOPE=order-status:invoke
SUPPORT_AGENT_ID=support-agent

# Inbound validation of the browser's own PKCE login token (audienced to
# this agent's own PingOne resource). Independent of the AGENT_IDP_* exchange
# credentials below — this validates what Agent Bridge handed this agent,
# before this agent ever uses it as a token-exchange subject_token.
SUPPORT_AGENT_AUDIENCE=support-agent
SUPPORT_AGENT_EXPECTED_SCOPE=support-agent:invoke

# Own RFC 8693 exchange targets this shared intermediate audience, not
# order-status-agent directly — the gateway extension performs the real
# exchange to order-status-agent on top of this one. Must match
# AGENT_GATEWAY_AUDIENCE in the gateway extension's own config.
AGENT_GATEWAY_AUDIENCE=ac-google-cloud-agent-gateway

# PingOne RFC 8693 exchange
LOCAL_DELEGATION_MODE=false
AGENT_IDP_TOKEN_ENDPOINT=https://auth.pingone.<region>/<environment-id>/as/token
AGENT_IDP_CLIENT_ID=replace-me
AGENT_IDP_CLIENT_SECRET=replace-me
