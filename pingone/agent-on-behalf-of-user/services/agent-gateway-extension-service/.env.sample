GC_REGION=us-central1
GC_CLOUD_RUN_SERVICE_NAME=aobou-agent-gateway-extension-service
IDP_TOKEN_ENDPOINT=https://auth.pingone.com/ENV_ID/as/token
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_SCOPE=stripe_mcp:invoke
# Audience of the INBOUND delegated token (= gateway resource audience, not the MCP tool's)
IDP_REQUIRED_AUDIENCE=google-agent-gateway
TOOL_URL=
AUTHZ_DECISION_ENDPOINT=https://api.pingone.ca/v1/environments/ENV_ID/decisionEndpoints/ENDPOINT_ID
AUTHZ_CLIENT_ID=
AUTHZ_CLIENT_SECRET=
