GC_PROJECT_ID=
GC_REGION=us-central1
AGENT_DISPLAY_NAME=aobou-financial-agent
TOOL_MCP_URL=https://aobou-stripe-mcp-server-PROJECT_NUMBER.REGION.run.app/mcp
GC_AGENT_GATEWAY=projects/PROJECT_ID/locations/REGION/agentGateways/AGENT_GATEWAY_NAME
# PingOne credentials for the agent's RFC 8693 token exchange
AGENT_IDP_TOKEN_ENDPOINT=https://auth.pingone.REGION/ENV_ID/as/token
AGENT_IDP_CLIENT_ID=
AGENT_IDP_CLIENT_SECRET=
AGENT_IDP_SCOPE=stripe_mcp:invoke
