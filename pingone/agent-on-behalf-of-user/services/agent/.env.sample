GC_REGION=us-central1
AGENT_DISPLAY_NAME=aobou-financial-agent
IDP_ISSUER=https://auth.pingone.<your-region>/<your-env>/as
# Bare gateway name — the full resource path is derived from gcloud at deploy time
GC_AGENT_GATEWAY=aobou-agent-gateway
# AOBOU Financial Agent in PingOne
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=
# URL and scope for the downstream stripe mcp server (outbound token)
TOOL_MCP_URL=https://aobou-stripe-mcp-server-<your-project-number>.<your-deployment-region>.run.app/mcp
TOOL_SCOPE=stripe_mcp:invoke
