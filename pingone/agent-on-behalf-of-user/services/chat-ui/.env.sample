GC_REGION=us-central1
GC_CLOUD_RUN_SERVICE_NAME=aobou-chat-ui
VITE_IDP_ISSUER=https://auth.pingone.<your-region>/<your-env>/as
# AOBOU Chat UI application in PingOne
VITE_CLIENT_ID=
VITE_REDIRECT_URI=https://aobou-chat-ui-<your-project-number>.<your-deployment-region>.run.app
# URL and scope for the downstream tool (outbound token)
VITE_AGENT_BRIDGE_URL=https://aobou-agent-bridge-<your-project-number>.<your-deployment-region>.run.app
VITE_SCOPES=openid profile email stripe_mcp:invoke
