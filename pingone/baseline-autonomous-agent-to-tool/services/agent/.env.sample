GC_PROJECT_ID=
GC_REGION=us-central1
AGENT_DISPLAY_NAME=baatt-crm-agent
IDP_ISSUER=https://auth.pingone.<your-region>/<your-env>/as
GC_AGENT_GATEWAY=projects/<your-project-id>/locations/<your-deployment-region>/agentGateways/<your-agent-gateway-name>
# BAATT CRM Agent in PingOne
AGENT_CLIENT_ID=your-agent-client-id
AGENT_CLIENT_SECRET=your-agent-client-secret
# URL and scope for the downstream tool (outbound token)
TOOL_MCP_URL=https://baatt-supply-chain-mcp-tool-<your-project-number>.<your-deployment-region>.run.app/mcp
TOOL_SCOPE=supply-chain:restock